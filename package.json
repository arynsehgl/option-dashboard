{
  "name": "stride-options-trading-platform",
  "version": "2.0.0",
  "description": "Stride options dashboard and guarded Trade Zone platform",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npx vite",
    "dev:netlify": "npx --yes netlify-cli@27.5.0 dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project demo-stride-rules \"npm run test:firestore-rules:unit\"",
    "test:firestore-rules:unit": "vitest run --config vitest.firestore.config.js",
    "worker:dev": "npm --prefix services/trade-worker run dev",
    "worker:build": "npm --prefix services/trade-worker run build",
    "worker:test": "npm --prefix services/trade-worker run test"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "firebase": "^12.8.0",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.544.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.12.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.16",
    "firebase-tools": "15.33.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}

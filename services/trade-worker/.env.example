NODE_ENV=development
PORT=3002
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated exact additional origins.
# FRONTEND_ORIGINS=https://myoptiontrade.netlify.app
# Optional deploy-preview allowlist for deploy-preview-N--SITE.netlify.app.
# NETLIFY_PREVIEW_SITE_NAME=myoptiontrade
PUBLIC_WORKER_URL=http://localhost:3002

# Number of trusted TLS reverse-proxy hops. Use 0 when clients reach the worker directly.
TRUST_PROXY_HOPS=0
MAX_STREAM_CLIENTS_PER_USER=5

# Server-only Supabase credentials. Never use these in a VITE_* variable.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY

# V1 Firebase remains the only user identity and entitlement source. Production
# requires both explicit fields unless ADC is deliberately enabled below.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREDACTED\n-----END PRIVATE KEY-----\n"
# FIREBASE_ALLOW_APPLICATION_DEFAULT=true
# FIREBASE_SUPERADMIN_EMAIL=verified-owner@example.com

# Server-only GitHub credential entitled to use the Copilot SDK.
GITHUB_TOKEN=YOUR_SERVER_ONLY_GITHUB_TOKEN
COPILOT_MODEL=gpt-5

# Keep false through paper validation and a separate live-readiness review.
LIVE_ORDERING_ENABLED=false

# The existing V1 Firebase project remains the only browser authentication and
# subscription source. Reuse the production V1 values unchanged in V2.
VITE_TRADE_WORKER_URL=http://localhost:3002

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated, case-insensitive browser administrator allowlist.
VITE_SUPERADMIN_EMAILS=first-owner@example.com,second-owner@example.com
# Legacy fallback used only when the plural setting is absent or blank.
VITE_SUPERADMIN_EMAIL=
